# Copy to .env for local runs. Never commit real values.

# --- Upstream: the Big Brain backend ---
API_URL=https://mindmirror-production.up.railway.app/api/v1
# Big Brain app key (ak_...), sent upstream as X-API-Key. Create one in the app's settings.
API_KEY=

# --- Inbound: the bearer Atlas must send as "Authorization: Bearer <MCP_TOKEN>" ---
# Generate with: openssl rand -hex 32
MCP_TOKEN=

# --- Railway ---
# This service's public hostname, no scheme (e.g. big-brain-mcp.up.railway.app).
# Required on Railway: the SDK's Host check otherwise answers every request with 421.
PUBLIC_HOST=

# --- Optional ---
UPSTREAM_TIMEOUT_SECONDS=10
RATE_LIMIT_PER_MINUTE=60
