# --- Outbound: how this service talks to the Big Brain backend ---
CHAT_API_URL=https://mindmirror-production.up.railway.app/api/v1
# Long-lived Big Brain API key (ak_...). Same one the Telegram bridge uses.
API_KEY=
# Your Supabase user UUID.
USER_ID=

# --- Inbound: the secret a calling agent must present ---
# Generate with:  openssl rand -hex 32
# The calling agent sends:  Authorization: Bearer <this value>
MCP_BEARER_TOKEN=

# --- Railway ---
# This service's own public hostname, no scheme. Required in production:
# the SDK's DNS-rebinding guard checks the Host header, which behind Railway's
# proxy is the public domain, not localhost.
PUBLIC_HOST=
# Set to 1 only if the calling client sends a Host/Origin the guard rejects.
DISABLE_DNS_REBINDING_PROTECTION=
